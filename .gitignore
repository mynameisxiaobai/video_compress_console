# 本地运行时配置（含个人路径，不要提交）
config.json

# 个人本地启动脚本（仓库统一用 start.bat）
启动.bat

# 依赖与日志
node_modules/
npm-debug.log*
*.log

# 运行时数据（任务历史 JSONL、运行日志），不要提交
data/

# 打包产物（发版用的 zip 与解压目录，走 Release 而不是仓库）
release/
dist/
*.zip

# 本地放的 ffmpeg 二进制（体积大、许可另说，别提交）
ffmpeg/bin/
ffmpeg/*.exe
ffmpeg/LICENSE
ffmpeg/THIRD-PARTY.txt
ffmpeg/FFMPEG-README.txt

# 完整版发布包里内置的 Node 运行时（打包时临时拷入，不入库）
node.exe

# 系统垃圾
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# 编辑器
.vscode/
.idea/
*.swp
